# Copy to .env.local and fill in. Real values never go in the repo.

# Tiger Cloud (TimescaleDB + PostGIS). Connection strings, SSL required.
DATABASE_URL=
DATABASE_URL_READONLY=

# ElevenLabs: the sound script, the triage, Ask and Ask the data agents, and the Ask voice. The
# five voices and the model are in lib/audio/voices.ts.
# `npm run agents` prints the three agent ids.
ELEVENLABS_API_KEY=
ELEVENLABS_TRIAGE_AGENT_ID=
ELEVENLABS_ASK_AGENT_ID=
ELEVENLABS_DATA_AGENT_ID=

# Gemini, from Google AI Studio, with billing turned on. Only for the fallback
# when the agents can't see images.
GEMINI_API_KEY=

# Turns device keys into hashes on civic reports. Never rotate it during the event.
DEVICE_HASH_SALT=

# Calls per hour across all devices (defaults 150, 120 and 60).
TRIAGE_HOURLY_BUDGET=
ASK_HOURLY_BUDGET=
DATA_HOURLY_BUDGET=

# Dashboard and site.
DASHBOARD_SHOW_SIMULATED=
NEXT_PUBLIC_SITE_NAME=
