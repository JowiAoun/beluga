# Copy to .env.local and fill in. Real values never go in the repo.

# Tiger Cloud (TimescaleDB + PostGIS). Connection strings, SSL required.
DATABASE_URL=
DATABASE_URL_READONLY=

# Gemini, from Google AI Studio. Use the key with billing turned on.
GEMINI_API_KEY=
GEMINI_TRIAGE_MODEL=
GEMINI_ASK_MODEL=

# ElevenLabs, for the sound script and the Ask voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=

# Turns device keys into hashes on civic reports. Never rotate it during the event.
DEVICE_HASH_SALT=

# Calls per hour across all devices (defaults 150 and 120).
GEMINI_HOURLY_BUDGET=
ASK_HOURLY_BUDGET=

# Dashboard and site.
DASHBOARD_SHOW_SIMULATED=
NEXT_PUBLIC_SITE_NAME=
